{{#if secondary}}
<a href="{{href}}" target="_blank" class="button bg-white border-2 border-orange-600 px-6 py-4 rounded-md text-orange-700 hover:bg-orange-50 transition-colors drop-shadow-md font-bold">{{label}}</a>
{{else}}
<a href="{{href}}" target="_blank" class="button bg-orange-600 px-6 py-4 rounded-md text-white hover:bg-orange-700 transition-colors drop-shadow-md font-bold">{{label}}</a>
{{/if}}
